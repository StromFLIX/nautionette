# Copy to .env and fill in. Never commit .env.

# Published port of the backend, the only entrypoint.
BACKEND_PORT=8080

# Model provider, reached only by agentgateway.
OPENROUTER_API_KEY=

# https://agentgateway.dev
AGENTGATEWAY_VERSION=v1.5.0

# Temporal
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentic-flow
TEMPORAL_VERSION=1.25.2
TEMPORAL_UI_VERSION=2.31.2

# Workers never scale to zero.
WORKER_REPLICAS=1

# Postgres, reachable only by Temporal. Generate a strong value.
POSTGRES_USER=temporal
POSTGRES_PASSWORD=

# Object storage (MaxIO). Generate strong values; these are root credentials.
MAXIO_VERSION=v0.4.2
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=agentic-flow

# Agent lifecycle: idle agent sets are stopped, pinned ones are kept.
AGENT_IDLE_TIMEOUT_SECONDS=900
PINNED_AGENT_SETS=

# Copy to .env and fill in. Never commit .env.

# Published ports, bound to loopback only. The backend is the one door.
BACKEND_PORT=8080
WEBSITE_PORT=8081

# Access token for the app. Leave empty for open mode (only sane on a laptop).
APP_TOKEN=
# Shared secret between backend, broker, workers and the authoring server.
INTERNAL_TOKEN=

# Model provider, reached only by agentgateway. Without it, agent calls fail
# and everything else still works.
OPENROUTER_API_KEY=
AGENT_MODEL=openai/gpt-4o-mini

# https://agentgateway.dev
AGENTGATEWAY_VERSION=v1.5.0

# Temporal
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nautionette
TEMPORAL_VERSION=1.29.0
TEMPORAL_UI_VERSION=2.34.0

# Workers never scale to zero.
WORKER_REPLICAS=1
WORKER_GRACE_SECONDS=50

# Postgres, reachable only by Temporal. Required, generate a strong value.
POSTGRES_USER=temporal
POSTGRES_PASSWORD=

# Agents: Pi is always zero between calls, so this is the ceiling for a single
# call, not an idle timeout.
DEFAULT_AGENT_SET=default
AGENT_RUN_TIMEOUT_SECONDS=900
AGENT_MEMORY_LIMIT=1g

# Where the promotional site points its "Open the app" buttons.
APP_URL=

{
  "name": "nautionette-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Denkzeug desktop and mobile client for your self-hosted instance",
  "author": "Denkzeug contributors",
  "main": "desktop/main.cjs",
  "desktopName": "nautionette.desktop",
  "build": {
    "appId": "dev.nautionette.app",
    "productName": "Denkzeug",
    "directories": { "output": "out/desktop" },
    "files": ["dist/**/*", "desktop/**/*", "package.json"],
    "asar": true,
    "protocols": [{ "name": "Denkzeug return", "schemes": ["denkzeug", "nautionette"] }],
    "artifactName": "denkzeug-v${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "extendInfo": { "NSMicrophoneUsageDescription": "Record dictation for your Denkzeug instance." }
    },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage"], "category": "Office", "syncDesktopName": true }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test src/*.test.js scripts/*.test.js",
    "test:e2e": "playwright test",
    "build": "vite build",
    "preview": "vite preview",
    "android:add": "cap add android && npm run android:sync",
    "android:sync": "cap sync android && node scripts/sync-android.mjs",
    "ios:add": "cap add ios --packagemanager SPM && npm run ios:sync",
    "ios:sync": "cap sync ios && node scripts/sync-ios.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --publish never",
    "desktop:build:ci": "node scripts/package-desktop.mjs",
    "test:website": "node --test ../website/*.test.mjs",
    "capture:website": "node scripts/capture-website.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@dagrejs/dagre": "^3.1.3",
    "@quasar/extras": "^2.1.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "css-tree": "^3.2.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "marked": "^18.2.0",
    "quasar": "^2.35.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "sass-embedded": "^1.108.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "app-builder-lib": { "minimatch@^10.2.5": "^11.0.5" },
    "@electron/universal": { "minimatch@^9.0.3": "^11.0.5" }
  }
}
